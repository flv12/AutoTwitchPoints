  "description": "Automatically collects Twitch channel points bonus.",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:manifest": "node scripts/build-manifest.js",
